{
  "compilerOptions": {
    "target": "ES2017",
    // "downlevelIteration": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },

    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",

    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    
    "./@/components/**/*.{js,ts,jsx,tsx,mdx}",

    "src/**/*.{js,ts,jsx,tsx,mdx}",
    "src/**.{js,ts,jsx,tsx,mdx}",
    "./app/**/*.{js,ts,jsx,tsx,mdx}", // For Next.js App Router
    "./components/**/*.{js,ts,jsx,tsx,mdx}",  
  ],
  "exclude": [
    "node_modules"
  ]
}
